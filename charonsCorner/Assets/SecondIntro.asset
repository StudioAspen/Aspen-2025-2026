MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 134dc740d30ba8e42a809cf45eef40b5, type: 3}
  m_Name: SecondIntro
  m_EditorClassIdentifier: 
  lines:
  - <?CamToCharon>Oh boy, another one...
  - <?CamToCharon><?MovePlayerFeedback>Humans have gotten boring; nobody interesting
    has shown up in decades...
  - <?CamToBowley><?BowleyStartShaking=5,15,3>Ok, but I'll bet another 25 years that
    THIS one will be-
  - <?CamToCharon>Remember the last time you said that?
  - "<?CamToBowley>I\u2019ll gamble my way out of debt if it kills me."
  - "<?CamToCharon><?CamSwitchSpeed=.25>You\u2019re that confident in <?CharonLooksAtPlayer><?ShakeCamera>THIS
    small-town-nobody?"
  - <?CameraPlayerCloseup><?PlayerScaredFeedback>...
  - <?CamToBowley>Well...
  - <?CamToCharon><?CameraShake>Goodbye.
  - <?CamToBowley>Fifty years.
  - <?CamToCharon>We never agreed to-
  - <?CamToBowley><?BowleyStartShaking=20,15,3>ONE HUNDRED YEARS
  - <?CamToCharon>...
  - <?CamToCharon>Fine
  - <?CamToBowley><?BowleyStartShaking=5,15,1>Yippee!
  - <?CamToCharon><?CamToBowlingAlley>Look, you see<?BowlingLights> those lanes?
  - <?CamToBowley><?CameraToBowlingAlleyPan><?BowlingPan>Those moments that flash
    before your eyes? Here.
  - <?CamToCharon>Anyone dying always has a lane
  - <?CharonLooksAtPlayer> And <?CameraShake>YOURS better be entertaining.
  - "<?CamToBowley> Don\u2019t think too much about it. Just focus on moving forward!"
  - <?GoToLevel0> \n
