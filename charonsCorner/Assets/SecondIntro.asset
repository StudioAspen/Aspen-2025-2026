  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 134dc740d30ba8e42a809cf45eef40b5, type: 3}
  m_Name: SecondIntro
  m_EditorClassIdentifier: 
  lines:
  - "<?CamToBowley><?BowleyStartShaking=15,15,1>And THAT\u2019S a wrap!"
  - <?CamToCharon>But humans have gotten boring; nobody interesting has shown up
    in decades...
  - <?CamToBowley><?BowleyStartShaking=5,15,3>Ok, but I bet another 25 years that
    THIS one will be-
  - <?CamToCharon><wiggle a=.5><?BowleyStartShaking=15,15,2>Remember the last time
    you said that?
  - "<?CamToBowley>I\u2019ll gamble my way out of debt if it kills me."
  - "<?CamToCharon><?CamSwitchSpeed=.25>You\u2019re that confident in THIS small
    town nobody?"
  - "<?CamToBowley><?ShakeCamera>Don\u2019t be such a Debbie Downer. It\u2019s not
    MY fault you couldn\u2019t appreciate-"
  - <?CamToCharon>Goodbye.
  - <?CamToBowley>Fifty years
  - <?CamToCharon>We never agreed to-
  - <?CamToBowley>ONE HUNDRED YEARS
  - <?CamToCharon>Look.
  - <?CamToBowley>Those moments that flash before your eyes? Here.
  - <?CamToCharon> Anyone dying always has a lane
  - <?CamToCharon> And YOURS better be entertaining.
  - "<?CamToCharon> Don\u2019t think too much about it. Just focus on moving forward!"
  - <?GoToLevel0> \n
