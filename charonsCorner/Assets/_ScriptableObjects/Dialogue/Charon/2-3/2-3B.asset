    bowleyAnimation: 
    text: "<wave>Hmm, you're right about that\u2026</wave>"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>Good, now that you've calmed down- </wiggle><shake>WAIT WAIT WAIT-</shake>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>I'M SORRY, I'M SORRY. I'M SORRY</shake>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>IT STINKS IN HERE</shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>I'll move you once I get a proper apology</wiggle>
  - speaker: 1
