  lines:
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>Ok that might've been too far</wiggle>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>I am <shake>REALLLLLLLLY</shake> tempted to throw <incr>YOU</incr>
      down the lane next</shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>Don't you remember what happened the last time you did that?!</shake>
  - speaker: 0
