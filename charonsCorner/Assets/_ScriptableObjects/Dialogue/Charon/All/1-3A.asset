  lines:
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdle
    text: <wave>Ah the classic opening up to your closest friend trope.</wave>
  - speaker: 0
    charonAnimation: CharonComeOn
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdle
    text: <wiggle a=.5>Told you there wasn't anything special about-
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYes
    text: <bounce>Now hold on there! It's a trope for a reason! It's setting up something
      bigger.</bounce>
  - speaker: 0
    charonAnimation: CharonScavengeInDesk
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYesSlow
    text: I don't think you know what a trope is-
  - speaker: 1
    charonAnimation: CharonScavengeInDesk
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdleFast
    text: <shake>UP BAP BAP, shhhhhhhh...</shake>
  - speaker: 1
    charonAnimation: CharonScavengeInDesk
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyIdleSlow
    text: <wave>You hear that?</wave>
  - speaker: 0
    charonAnimation: Null
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyIdleSlow
    text: ...No...
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyYes
    text: <wiggle>The negative Nancy is gone!</wiggle>
