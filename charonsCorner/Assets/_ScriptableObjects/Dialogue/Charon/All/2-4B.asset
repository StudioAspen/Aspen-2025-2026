MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 969c813e1085c9049bd8463efe9e628c, type: 3}
  m_Name: 2-4B
  m_EditorClassIdentifier: 
  <SequenceName>k__BackingField: 2-3 B
  lines:
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyIdle
    cameraShake: 0
    text: <wiggle>I just didn't think you had it in you.</wiggle>
  - speaker: 1
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdleFast
    cameraShake: 1
    text: <shake>Were your eyes closed? Everything was building up towards this!</shake>
  - speaker: 1
    charonAnimation: CharonScavengeInDesk
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdle
    cameraShake: 1
    text: '<wiggle>The indifference! The complacency! Never choosing anything for
      himself and letting the world choose his life for him! '
  - speaker: 1
    charonAnimation: CharonScavengeInDesk
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYesFast
    cameraShake: 1
    text: <wiggle>It was BOUND to build up and explode in one way or another!
  - speaker: 0
    charonAnimation: CharonScavengeInDesk
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyIdle
    cameraShake: 0
    text: <wave>Still...
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyYes
    cameraShake: 0
    text: <wave>There had to have been a better option than THAT...
