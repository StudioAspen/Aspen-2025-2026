  lines:
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYes
    text: <bounce>Hey hey! Not a bad premiere!</bounce>
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: 
    text: <wiggle>Beginner's luck.</wiggle>
  - speaker: 1
    charonAnimation: Null
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYes
    text: <dangle>Ooo is that a head tilt of approval I see?</dangle>
  - speaker: 0
    charonAnimation: CharonComeOn
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYes
    text: <shake>YOU can't SEE anything.</shake>
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdle
    text: <wave>Cmooooon loosen up a little.</wave>
  - speaker: 1
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdleFast
    text: <bounce>You gotta really get into it, start using that big ol' brain of
      yours.</bounce>
  - speaker: 1
    charonAnimation: Null
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyYesFast
    text: <wave>Don't even get me started on how the flying fruit could be a metaphor
      for...</wave>
  - speaker: 0
    charonAnimation: CharonScavengeInDesk
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyYesFast
    text: <?GE=CharonCameraZoomIn><shake>Hey</shake>
  - speaker: 0
    charonAnimation: Null
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: Null
    text: <?LookAtMementoCam><?GE=LookAtMementoZoomIn>That thing just appeared in
      my alley.
  - speaker: 0
    charonAnimation: Null
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: Null
    text: I can't talk to it, move it, nothing.
  - speaker: 0
    charonAnimation: Null
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: Null
    text: <?DefaultDialogueCam><wiggle><?GE=MLookAround>Did it just, look at me?
      Or you?</wiggle>
  - speaker: 0
    charonAnimation: CharonPointToAlley
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyYes
    text: <?GE=CharonCameraZoomOut>Take care of it.
