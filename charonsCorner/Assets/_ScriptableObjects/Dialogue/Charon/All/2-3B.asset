  lines:
  - speaker: 0
    charonAnimation: CharonComeOn
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdle
    cameraShake: 0
    text: <wiggle a*.5>I am <shake>REALLLLLLLLY</shake> tempted to throw <incr>YOU</incr>
      down the lane next
  - speaker: 0
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyNo
    cameraShake: 0
    text: <shake>Don't you remember what happened the last time you did that?!</shake>
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyNo
    cameraShake: 0
    text: "<wave>Hmm, you're right about that\u2026</wave>"
  - speaker: 1
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYes
    cameraShake: 0
    text: <wiggle a*.5>Good, now that you've calmed down-
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyIdleSlow
    cameraShake: 1
    text: <?GE=BowleyFall><shake>WAIT WAIT WAIT-</shake>
  - speaker: 1
