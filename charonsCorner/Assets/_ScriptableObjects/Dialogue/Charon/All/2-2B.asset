  lines:
  - speaker: 0
    charonAnimation: CharonComeOn
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyNoSlow
    cameraShake: 0
    text: <wiggle a*.5>Look, who am I to go against the advice of the love guru herself?</wiggle>
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyNo
    cameraShake: 0
    text: <dangle>Does your heart not beat in that cold rib cage of yours?</dangle>
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyNoSlow
    cameraShake: 0
    text: <wiggle a*.5>You're still around aren't you?</wiggle>
  - speaker: 1
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyYes
    cameraShake: 0
    text: <wave>Well what <shake>WE</shake> have is special.</wave>
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyYesFast
    cameraShake: 1
    text: <shake>SOMETHING NO TRUE LOVE CAN EVER REPLACE</shake>
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyIdleSlow
    cameraShake: 0
    text: "\u2026"
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyYesSlow
    cameraShake: 0
    text: <wiggle a*.5>I should call Hermes...
