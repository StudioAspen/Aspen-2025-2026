  lines:
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYesFast
    text: <bounce><?CameraShake>DID YOU SEE THAT KICK??</bounce>
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdleFast
    text: <bounce><?CameraShake>BEAUTIFUL! ABSOLUTELY STUNNING!</bounce>
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyIdle
    text: <wave>Not bad with the ball. I'm sure your friend was happy for you, in
      a way.</wave>
  - speaker: 1
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyNoSlow
    text: "<wiggle>Anyways\u2026</wiggle>"
  - speaker: 1
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyYes
    text: <wiggle>Time for you to <shake>PAY UP</shake></wiggle>
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyIdle
    text: <wiggle>What was the deal again?</wiggle>
  - speaker: 1
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: BowleyYesSlow
    text: <dangle>Don't play dumb with me Char-bear~</dangle>
  - speaker: 0
    charonAnimation: CharonComeOn
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: BowleyYesSlow
    text: <wiggle>Fine, just don't get too used to winning.</wiggle>
  - speaker: 0
    charonAnimation: CharonLaying
    charonStareAnimation: CharonStopStaring
    bowleyAnimation: BowleyIdle
    text: ...
  - speaker: 0
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: BowleyIdleFast
    text: "<wiggle><?GE=ChefHat>Now, did you want fries with the hot dog or\u2026</wiggle>"
