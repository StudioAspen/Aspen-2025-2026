  lines:
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Ah the classic opening up to your closest friend trope.</wave>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "<wiggle>Told you there wasn't anything special about\u2026</wiggle>"
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <bounce>Now hold on there, it's a trope for a reason, the setup for something
      bigger.</bounce>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "<wiggle>I don't think you know what a trope is\u2026</wiggle>"
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>UP BAP BAP, shhhhhhhh</shake>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>You hear that?</wave>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: ...
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>The negative Nancy is gone.</wiggle>
