  <SequenceName>k__BackingField: 2-3 A
  lines:
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>CHARON, YOU SEE THIS RIGHT?!</shake>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <bounce>THEY MAKE SUCH A GOOD COUPLE DON'T THEY?!</bounce>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Well judging by how they're looking at us, surely it wasn't all sunshine
      and rainbows?</wave>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <dangle>Charon, honey, how did <shake>YOUR</shake> last relationship go?</dangle>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>Look, that wasn't going to go anywhere</wiggle>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <dangle><shake>OH</shake>? How do <shake>YOU</shake> know that?</dangle>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Aphrodite got involved, said it wasn't going to work out</wave>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <shake><incr>AND YOU JUST LISTENED TO HER?</incr></shake>
