  <SequenceName>k__BackingField: 2-2B
  lines:
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>Look, who am I to go against the advice of the love guru herself?</wiggle>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <dangle>Does your heart not beat in that cold rib cage of yours?</dangle>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>You're still around aren't you?</wiggle>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Well what <shake>WE</shake> have is special.</wave>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>SOMETHING NO TRUE LOVE CAN EVER REPLACE</shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "\u2026"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>I should call Hermes.
