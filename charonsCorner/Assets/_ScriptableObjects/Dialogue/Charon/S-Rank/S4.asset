  lines:
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>What <shake>IS</shake> it that drives you?</wave>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Is it desperation?</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Hope that things play out differently?</pend>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake><rot><incr>You did this to me!</incr></rot></shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>No matter what you do, it always ends the same.</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>You can't change the past.</pend>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake><rot>Do you feel <incr>NOTHING</incr>?!</rot></shake>
