  lines:
  - speaker: 0
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: 
    text: <wave>What <shake>IS</shake> it that drives you?</wave>
  - speaker: 0
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareUp
    bowleyAnimation: 
    text: Is it desperation?
  - speaker: 0
    charonAnimation: CharonComeOn
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: 
    text: Hope that things play out differently?
  - speaker: 3
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: 
    text: <shake><?CameraShake><incr>You did this to me!</incr></shake>
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: 
    text: No matter what you do, it always ends the same.
  - speaker: 0
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareAtBowley
    bowleyAnimation: 
    text: You can't change the past.
  - speaker: 3
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareUp
    bowleyAnimation: 
    text: <shake>Do you feel <?CameraShake><incr>NOTHING</incr>?!</shake>
