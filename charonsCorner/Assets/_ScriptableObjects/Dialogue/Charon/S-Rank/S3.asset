  lines:
  - speaker: 0
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: 
    text: Do you yearn for your past?
  - speaker: 3
    charonAnimation: CharonTalkingToBowley
    charonStareAnimation: CharonStareUp
    bowleyAnimation: 
    text: <shake><incr><?CameraShake>It's your fault...</incr></shake>
  - speaker: 0
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: 
    bowleyAnimation: 
    text: The joys and sorrows long gone?
  - speaker: 3
    charonAnimation: CharonSeatedIdle
    charonStareAnimation: CharonStareUp
    bowleyAnimation: 
    text: <shake><incr><?CameraShake>It's all your fault!</incr></shake>
  - speaker: 0
    charonAnimation: CharonComeOn
    charonStareAnimation: CharonStareAtPlayer
    bowleyAnimation: 
    text: <wave>Or are you just deceiving yourself?</wave>
  - speaker: 3
