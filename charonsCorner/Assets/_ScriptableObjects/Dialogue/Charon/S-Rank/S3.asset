  lines:
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Do you yearn for your past?</pend>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake><rot><incr>It's your fault.</incr></rot></shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>The joys and sorrows long gone?</pend>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake><rot><incr>It's all your fault!</incr></rot></shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Or are you just deceiving yourself?</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake><rot><incr>YOUR FAULT!!!</incr></rot></shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: Keep it up though, it's entertaining.
