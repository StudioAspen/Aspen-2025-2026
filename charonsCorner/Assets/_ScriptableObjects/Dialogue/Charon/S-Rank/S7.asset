  lines:
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>...</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Well, that was certainly a film.</wave>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>But was it <shake>GOOD</shake>?!</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Enough to make the years drop.</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "<shake>ARE YOU SAYING THAT\u2026</shake>"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>I didn't <shake>SAY</shake> anything.</wiggle>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: But <shake>YOU</shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: I don't <shake>DO</shake> favors.
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: I don't <shake>DO</shake> three strikes.
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "<pend>So listen here and listen well\u2026</pend>"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "<pend>This is your last chance\u2026</pend>"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "<pend>This is my last test\u2026</pend>"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: So don't screw it up.
