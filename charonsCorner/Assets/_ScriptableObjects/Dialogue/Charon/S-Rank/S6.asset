  <SequenceName>k__BackingField: S6
  lines:
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: "<pend>Replaying these scenes over and over\u2026</pend>"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Most don't even bother.</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>At least not the painful ones.</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>You regret your life, don't you?</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>How you lived it.</pend>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Your decisions.</pend>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: "<wave>Even if you did have a second chance\u2026</wave>"
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Would you waste it like the first?</pend>
