  <SequenceName>k__BackingField: S5
  lines:
  - speaker: 0
    text: I see it in your soul.
  - speaker: 0
    text: "You\u2019re serious about this, aren\u2019t you?"
  - speaker: 2
    text: All you did was hurt us.
  - speaker: 0
    text: "Well, it\u2019s not like\u2026"
  - speaker: 2
    text: Is this supposed to be some kind of apology?
  - speaker: 0
    text: ... you're getting a second chance.
