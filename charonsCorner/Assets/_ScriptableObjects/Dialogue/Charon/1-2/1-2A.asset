  <SequenceName>k__BackingField: 1-2A
  lines:
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <bounce>Hey hey! Not a bad premiere!</bounce>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>Beginner's luck.</wiggle>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <dangle>Ooo is that a head tilt of approval I see?</dangle>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>YOU can't SEE anything.</shake>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Cmooooon loosen up a little.</wave>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: <bounce>You gotta really get into it, start using that big ol' brain of
      yours.</bounce>
  - speaker: 1
    charonAnimation: 
    bowleyAnimation: 
    text: "<wave>Don't even get me started on how the flying fruit could be a metaphor
      for\u2026</wave>"
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>Hey</shake>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: That thing just appeared in my alley.
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: I can't talk to it, move it, nothing.
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>Did it just, look at me? Or you?</wiggle>
  - speaker: 0
    charonAnimation: 
    bowleyAnimation: 
    text: Take care of it
