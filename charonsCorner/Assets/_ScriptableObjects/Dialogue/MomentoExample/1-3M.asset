  lines:
  - speaker: 2
    charonAnimation: MExcited
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wave>I really enjoyed your company.</wave>
  - speaker: 2
    charonAnimation: MHighEnergySingleWave
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wave>It was nice to talk to someone about everything.</wave>
  - speaker: 2
    charonAnimation: MHappy
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wiggle>I thought you'd be too cool for plushies.</wiggle>
  - speaker: 2
    charonAnimation: MWavingMidEnergy
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wave>But I'm happy you liked Waffles.</wave>
  - speaker: 2
    charonAnimation: MThinking
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wave>How is it doing by the way?</wave>
  - speaker: 2
    charonAnimation: MHappy
    charonStareAnimation: 
    bowleyAnimation: 
    text: Do you still sleep with it?
