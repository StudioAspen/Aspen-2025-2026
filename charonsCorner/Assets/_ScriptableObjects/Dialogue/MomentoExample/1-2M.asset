  <SequenceName>k__BackingField: 1-2B
  lines:
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Quite the fiesta in there, wasn't it?</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wiggle>Or maybe it was closer to a warzone.</wiggle>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <bounce>I enjoyed it, all the running and ducking? It was exciting!</bounce>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>Even if my clothes got messed up, I'm sure my parents would understand.</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <bounce>In fact, I think they'd be pretty happy to see that I found a friend!</bounce>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>I'm sure yours would be glad too!</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Right?</pend>
