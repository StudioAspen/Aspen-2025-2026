  lines:
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>I can't take this anymore</pend>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>The bills are piling up</shake>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>The place is a wreck</shake>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <shake>You're just on the couch, doing who knows what</shake>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: Who am I to you?
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: What am I to you?
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Because you were <shake>EVERYTHING</shake> to me</pend>
