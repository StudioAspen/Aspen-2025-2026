  lines:
  - speaker: 2
    charonAnimation: MSadIdle
    charonStareAnimation: 
    bowleyAnimation: 
    text: So that's that.
  - speaker: 2
    charonAnimation: MRejected
    charonStareAnimation: 
    bowleyAnimation: 
    text: ...
  - speaker: 2
    charonAnimation: MSadIdle
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wave>I was happy that you listened.</wave>
  - speaker: 2
    charonAnimation: MRejected
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wave>I was happy that you didn't judge me.</wave>
  - speaker: 2
    charonAnimation: MStandIdle
    charonStareAnimation: 
    bowleyAnimation: 
    text: <wave>I was happy that you were <shake>WITH</shake> me.</wave>
  - speaker: 2
    charonAnimation: MHappy
