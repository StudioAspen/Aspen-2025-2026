  <SequenceName>k__BackingField: 2-2B
  lines:
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>I remember the day we first met</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>You looked lonely, all by yourself.</pend>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>I just had to come over and talk to you.</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <bounce>And now look at us!</bounce>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>We've come so far.</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <wave>I can't wait to spend the rest of my life with you.</wave>
  - speaker: 2
    charonAnimation: 
    bowleyAnimation: 
    text: <pend>Till death do us part.</pend>
