  <SequenceName>k__BackingField: 2-2B
  lines:
  - speaker: 2
    text: I remember the day we first met
  - speaker: 2
    text: You looked lonely, all by yourself.
  - speaker: 2
    text: I just had to come over and talk to you.
  - speaker: 2
    text: And now look at us!
  - speaker: 2
    text: "We\u2019ve come so far."
  - speaker: 2
    text: "I can\u2019t wait to spend the rest of my life with you."
  - speaker: 2
    text: Till death do us part.
