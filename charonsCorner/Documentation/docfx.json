{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Scripts/**/**.cs",
            "Editor/**.cs",
            "LevelEditor/**/**.cs",
            "Tools/AssetFlow/Editor/**.cs"
          ],
          "src": "../Assets/"
        }
      ],
      "dest": "api",
      "filter": "filter.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "templates/unity",
      "default"
    ],
    "globalMetadata": {
      "_appName": "Charons Corner Documentation",
      "_appTitle": "Charons Corner Documentation",
      "_enableSearch": true,
      "_enableNewSearch": true,
      "pdf": false
    }
  }
}